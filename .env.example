# Copie ce fichier en .env :  cp .env.example .env
# .env est ignoré par git. Ne mets jamais de vrai secret dans .env.example.

# --- Base locale (Docker) ---
POSTGRES_DB=emploi
POSTGRES_USER=emploi
POSTGRES_PASSWORD=change-moi
POSTGRES_PORT=5433

# Adresse utilisée par le code Python.
# Plus tard, pour Supabase : remplacer par l'adresse fournie dans le tableau de bord Supabase.
DATABASE_URL=postgresql://emploi:change-moi@localhost:5433/emploi

# --- Google (OAuth, application de bureau) ---
# Fichier téléchargé depuis la console Google Cloud (projet emploi-app).
GOOGLE_CLIENT_SECRET=secrets/client_secret.json
# Créé automatiquement à la première connexion.
GOOGLE_TOKEN=secrets/token.json
# Boîtes Gmail à lire (nom court). Jeton : secrets/token.json pour "principale",
# secrets/token_<nom>.json pour les autres.
GMAIL_BOITES=principale,ancienne

# --- Adzuna (https://developer.adzuna.com, compte déjà créé) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Gemini (https://aistudio.google.com/apikey) : moteur ATS ---
GEMINI_API_KEY=
GEMINI_MODELE=

# --- Supabase (mode en ligne, interface sur GitHub Pages) ---
# Publiques (Project Settings → API) :
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SECRÈTE (Connect → Session pooler), ne jamais la publier :
SUPABASE_DATABASE_URL=
# Publication de l'interface :
PAGES_DEPOT=https://github.com/filou337/emploi.git
PAGES_URL=https://filou337.github.io/emploi/
